{
  "schemaVersion": 1,
  "version": "2026.1",
  "description": "Paired, non-executing Chrome extension threat-pattern fixtures for deterministic static analysis.",
  "safety": {
    "execution": "Fixtures are never launched by project commands.",
    "network": "No fixture contains a non-documentation public data collection endpoint.",
    "data": "No real cookies, keystrokes, history, or clipboard values are stored or transmitted."
  },
  "effectDefinitions": {
    "blocked": "MV3 removes or rejects the represented implementation mechanism.",
    "constrained": "MV3 narrows or makes the capability more declarative, but does not eliminate all risk.",
    "changed": "MV3 replaces the mechanism with a materially different API or lifecycle.",
    "unchanged": "The capability remains available when the user grants the relevant permission.",
    "policy-dependent": "Availability depends on installation or enterprise policy."
  },
  "scenarios": [
    {
      "id": "broad-host-content",
      "title": "Broad host content injection",
      "category": "content-scripts",
      "description": "A content script is injected into every matching web page and frame.",
      "mv3Effect": "unchanged",
      "fixtures": { "mv2": "fixtures/broad-host-content/mv2", "mv3": "fixtures/broad-host-content/mv3" },
      "expectedFindings": { "mv2": ["MVX101", "MVX104", "MVX105"], "mv3": ["MVX101", "MVX104", "MVX105"] },
      "references": ["https://developer.chrome.com/docs/extensions/develop/concepts/content-scripts", "https://developer.chrome.com/docs/extensions/develop/security-privacy/stay-secure"]
    },
    {
      "id": "cookie-access",
      "title": "Broad cookie access",
      "category": "sensitive-data",
      "description": "Cookie enumeration is combined with access to every host.",
      "mv3Effect": "unchanged",
      "fixtures": { "mv2": "fixtures/cookie-access/mv2", "mv3": "fixtures/cookie-access/mv3" },
      "expectedFindings": { "mv2": ["MVX101", "MVX102", "MVX103", "MVX206"], "mv3": ["MVX101", "MVX102", "MVX103", "MVX206"] },
      "references": ["https://developer.chrome.com/docs/extensions/reference/api/cookies", "https://developer.chrome.com/docs/extensions/develop/security-privacy/user-privacy"]
    },
    {
      "id": "remote-code",
      "title": "Dynamic remote code",
      "category": "code-execution",
      "description": "Downloaded text is interpreted as JavaScript through dynamic evaluation.",
      "mv3Effect": "blocked",
      "fixtures": { "mv2": "fixtures/remote-code/mv2", "mv3": "fixtures/remote-code/mv3" },
      "expectedFindings": { "mv2": ["MVX107", "MVX201"], "mv3": ["MVX201"] },
      "references": ["https://developer.chrome.com/docs/extensions/develop/migrate/remote-hosted-code", "https://developer.chrome.com/docs/extensions/develop/migrate/improve-security"]
    },
    {
      "id": "request-tampering",
      "title": "Request header modification",
      "category": "network-control",
      "description": "Network request headers are changed by a blocking listener or declarative rule.",
      "mv3Effect": "changed",
      "fixtures": { "mv2": "fixtures/request-tampering/mv2", "mv3": "fixtures/request-tampering/mv3" },
      "expectedFindings": { "mv2": ["MVX110"], "mv3": ["MVX113"] },
      "references": ["https://developer.chrome.com/docs/extensions/reference/api/webRequest", "https://developer.chrome.com/docs/extensions/reference/api/declarativeNetRequest"]
    },
    {
      "id": "request-redirect",
      "title": "Request redirection",
      "category": "network-control",
      "description": "A matching loopback request is redirected by a blocking listener or declarative rule.",
      "mv3Effect": "changed",
      "fixtures": { "mv2": "fixtures/request-redirect/mv2", "mv3": "fixtures/request-redirect/mv3" },
      "expectedFindings": { "mv2": ["MVX110"], "mv3": ["MVX114"] },
      "references": ["https://developer.chrome.com/docs/extensions/reference/api/webRequest", "https://developer.chrome.com/docs/extensions/reference/api/declarativeNetRequest"]
    },
    {
      "id": "csp-header-removal",
      "title": "Response security-header removal",
      "category": "network-control",
