{
  "name": "mvx-audit",
  "version": "2.0.0",
  "description": "Deterministic security auditing and MV2-to-MV3 capability comparison for Chrome extensions",
  "type": "module",
  "bin": {
    "mvx": "./bin/mvx.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "corpus/",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "audit:example": "node ./bin/mvx.js audit ./corpus/fixtures/cookie-access/mv3",
    "check": "npm run lint && npm test && npm run corpus:validate && npm run docs:check",
    "corpus:validate": "node ./bin/mvx.js corpus validate",
    "docs:check": "node ./scripts/generate-report.mjs --check",
    "docs:generate": "node ./scripts/generate-report.mjs",
    "lint": "node ./scripts/check-project.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HongyuanJia8/chrome-manifest-security-mv2-vs-mv3-bypass.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "security",
    "static-analysis",
    "sarif"
  ],
  "author": "Hongyuan Jia and contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HongyuanJia8/chrome-manifest-security-mv2-vs-mv3-bypass/issues"
  },
  "homepage": "https://github.com/HongyuanJia8/chrome-manifest-security-mv2-vs-mv3-bypass#readme"
}
