{
  "name": "mvx-audit",
  "version": "3.0.0",
  "description": "Reproducible security auditing, threat intelligence, and isolated analysis for Chrome extensions",
  "type": "module",
  "bin": {
    "mvx": "./bin/mvx.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "corpus/",
    "intel/",
    "lab/",
    "scripts/run-lab.mjs",
    "scripts/smoke-lab.mjs",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "audit:example": "node ./bin/mvx.js audit ./corpus/fixtures/cookie-access/mv3",
    "check": "npm run lint && npm test && npm run corpus:validate && npm run intel:validate && npm run docs:check",
    "corpus:validate": "node ./bin/mvx.js corpus validate",
    "docs:check": "node ./scripts/generate-report.mjs --check",
    "docs:generate": "node ./scripts/generate-report.mjs",
    "intel:check": "node ./scripts/update-intelligence.mjs --check",
    "intel:update": "node ./scripts/update-intelligence.mjs",
    "intel:validate": "node ./bin/mvx.js intel validate",
    "lab:build": "docker build --tag mvx-lab:local ./lab",
    "lab:run": "node ./scripts/run-lab.mjs",
    "lab:smoke": "node ./scripts/smoke-lab.mjs",
    "lint": "node ./scripts/check-project.mjs",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyj28/mvx-audit.git"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "security",
    "static-analysis",
    "sarif"
  ],
  "author": "Hongyuan Jia and contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hyj28/mvx-audit/issues"
  },
  "homepage": "https://github.com/hyj28/mvx-audit#readme"
}
